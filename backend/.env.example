# Copie este arquivo para .env e ajuste os valores.
# O .env NAO vai para o git.

# --- Servidor ---
PORTA=3000
NODE_ENV=development

# --- Banco de dados ---
# Na Vercel (Neon pelo Marketplace) use DATABASE_URL e DATABASE_URL_UNPOOLED, que a
# integracao ja cria, e DB_SSL=true; com DATABASE_URL as variaveis DB_* abaixo sao ignoradas.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# DB_SSL=false
#
# Local: estes valores batem com o docker-compose.yml deste repositorio.
DB_HOST=localhost
DB_PORTA=5432
DB_USUARIO=diagrameria
DB_SENHA=diagrameria
DB_NOME=diagrameria

# Banco usado pelos testes de integracao (nunca aponte para o banco de desenvolvimento:
# a suite limpa as tabelas entre os testes).
DB_NOME_TESTE=diagrameria_teste

# --- Autenticacao ---
# Troque por um valor aleatorio. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# A aplicacao se recusa a subir sem esta variavel.
JWT_SEGREDO=troque-este-valor-antes-de-rodar
JWT_EXPIRACAO=24h

# --- Frontend ---
# Origem permitida no CORS (onde o React roda).
ORIGEM_PERMITIDA=http://localhost:5173
